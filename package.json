{
  "name": "course-reminder",
  "version": "1.1.0",
  "private": true,
  "description": "本地学习计划提醒与课程浏览器",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/schedule-parser.test.js",
    "package": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.course.reminder",
    "productName": "课程提醒",
    "electronDist": "node_modules/electron/dist",
    "compression": "store",
    "directories": { "output": "release" },
    "extraResources": [
      { "from": "examples/示例课表.md", "to": "learning-plan.md" },
      { "from": "AI课表生成提示词.md", "to": "ai-schedule-prompt.md" }
    ],
    "win": { "target": ["portable"], "signAndEditExecutable": false }
  }
}
